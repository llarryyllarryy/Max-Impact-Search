<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:versionCode="22">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaxImpactSearch"
        android:usesCleartextTraffic="true"
        tools:targetApi="37">

	    <receiver
		     android:name=".SearchWidgetProvider"
		     android:exported="true"
		     android:label="MaxImpactSearch">
		    <intent-filter>
			    <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
		    </intent-filter>
		    <meta-data
			      android:name="android.appwidget.provider"
			      android:resource="@xml/search_widget_info"/>
	    </receiver>
	    
	    <activity
		     android:name=".QueryActivity"
		     android:exported="false"
		     android:theme="@android:style/Theme.DeviceDefault.Light.Dialog"
		     android:taskAffinity=""
    android:excludeFromRecents="true"/>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


    </application>
    <uses-feature android:name="android.hardware.touchscreen" android:required="true"
        tools:ignore="MissingClass" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>

    <!-- Android 11+ (API 30+): lets isRecognitionAvailable() / SpeechRecognizer see the device's speech service -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>

</manifest>
